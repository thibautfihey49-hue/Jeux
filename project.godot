map/move_backward/trigger_names=PackedStringArray["key_s"]
map/move_left/trigger_names=PackedStringArray["key_a"]
map/move_right/trigger_names=PackedStringArray["key_d"]
map/jump/trigger_names=PackedStringArray["key_space"]

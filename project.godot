; Engine configuration file
[application]
config/name="MondeOuvert_Exploration"
config/features=PackedStringArray("4.3")
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/vsync_mode=1

[rendering]

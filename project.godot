; Engine configuration file
[application]
config/name="MondeOuvert_Exploration"
config/features=PackedStringArray("4.3")
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[input]
map/move_forward={"deadzone": 0.5, "event": InputEventKey(physical_key=KEY_W, pressed=true)}
map/move_backward={"deadzone": 0.5, "event": InputEventKey(physical_key=KEY_S, pressed=true)}
map/move_left={"deadzone": 0.5, "event": InputEventKey(physical_key=KEY_A, pressed=true)}
map/move_right={"deadzone": 0.5, "event": InputEventKey(physical_key=KEY_D, pressed=true)}
map/jump={"deadzone": 0.5, "event": InputEventKey(physical_key=KEY_SPACE, pressed=true)}
